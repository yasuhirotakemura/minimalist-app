{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // eslint.config.ts はflat configの型がpnpmのnode_modules構造では可搬に解決できないため、
  // typecheck対象へ含めない。設定の妥当性は `pnpm lint` の実行で検証する。
  "include": ["vite.config.ts", "vitest.config.ts", "postcss.config.js"]
}
