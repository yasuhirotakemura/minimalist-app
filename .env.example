# ---------------------------------------------------------------------------
# LESS local development environment
# `cp .env.example .env` してから値を調整する。
# 秘密値をGitへcommitしない。
# ---------------------------------------------------------------------------

# local | staging | production
# local以外ではsession CookieへSecure属性を付与する。
APP_ENV=local

# reverse proxy経由でWebとAPIを同一オリジンで公開する。
WEB_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api

# PostgreSQL
POSTGRES_USER=less
POSTGRES_PASSWORD=less_local_password
POSTGRES_DB=less
POSTGRES_PORT=5432
DATABASE_URL=postgres://less:less_local_password@postgres:5432/less?sslmode=disable

# session
SESSION_COOKIE_NAME=less_session
SESSION_TTL_HOURS=720

# 認証secret。本番では32文字以上のrandom値へ差し替える。
PASSWORD_PEPPER=local_password_pepper_change_me
CSRF_SECRET=local_csrf_secret_change_me

# CORS。同一オリジン配信のため通常は空で良い。
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=debug

# Phase 6で使用する上限値。Phase 0では読み込みのみ行う。
MAX_IMPORT_SIZE_MB=10
EXPORT_TTL_MINUTES=15

# API listen port (container内)
API_PORT=8081

# integration testで既存PostgreSQLを再利用する場合に設定する。
# 未設定の場合はtestcontainers-goがPostgreSQLを起動する。
TEST_DATABASE_URL=
